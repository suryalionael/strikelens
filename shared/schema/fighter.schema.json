{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/suryalionael/strikelens/shared/schema/fighter.schema.json",
  "title": "Fighter",
  "description": "A fighter. Corner (red or blue) is set per fight, not here.",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "name"],
  "properties": {
    "id": { "type": "string", "format": "uuid" },
    "name": { "description": "Full name as billed.", "type": "string", "minLength": 1 },
    "nickname": { "type": ["string", "null"] },
    "gym": { "type": ["string", "null"] },
    "country": {
      "description": "ISO 3166-1 alpha-2 code, e.g. \"ID\".",
      "type": ["string", "null"],
      "pattern": "^[A-Z]{2}$"
    }
  }
}
